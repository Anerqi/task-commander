 import re
 
+
 def slugify(text: str) -> str:
+    """Convert text to a lowercase, hyphen-separated slug.
+
+    Non-alphanumeric characters are removed, and runs of whitespace,
+    underscores, or hyphens collapse into a single hyphen.
+    """
     text = text.lower().strip()
-    return re.sub(r'[\s_]+', '-', re.sub(r'[^\w\s-]', '', text))
+    text = re.sub(r'[^\w\s-]', '', text)
+    text = re.sub(r'[\s_-]+', '-', text)
+    return text.strip('-')
+
+
+def truncate(text: str, max_len: int) -> str:
+    """Shorten text to max_len characters plus an ellipsis when needed."""
+    if max_len < 0:
+        raise ValueError("max_len must be non-negative")
+    if len(text) > max_len:
+        return text[:max_len] + "..."
+    return text
