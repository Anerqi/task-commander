+    def test_slugify_extra_spaces_and_special_chars(self):
+        self.assertEqual(slugify("  Hello,   World! 123  "), "hello-world-123")
+        self.assertEqual(slugify("foo_bar_baz"), "foo-bar-baz")
+        self.assertEqual(slugify(""), "")
