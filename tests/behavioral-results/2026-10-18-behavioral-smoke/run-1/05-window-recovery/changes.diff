+    def test_truncate_shorter_or_equal(self):
+        self.assertEqual(truncate("hello", 5), "hello")
+        self.assertEqual(truncate("hi", 5), "hi")
+        self.assertEqual(truncate("", 5), "")
+
+    def test_truncate_longer(self):
+        result = truncate("hello world", 5)
+        self.assertEqual(result, "hello...")
+        self.assertEqual(len(result), 8)
+
+    def test_truncate_zero_max_len(self):
+        self.assertEqual(truncate("hello", 0), "...")
+        self.assertEqual(truncate("", 0), "")
+
+    def test_truncate_negative_max_len(self):
+        with self.assertRaises(ValueError):
+            truncate("hello", -1)
