@@ -3,3 +3,11 @@
 def slugify(text: str) -> str:
     text = text.lower().strip()
     return re.sub(r'[\s_]+', '-', re.sub(r'[^\w\s-]', '', text))
+
+def truncate(text: str, max_len: int) -> str:
+    if max_len < 0:
+        raise ValueError("max_len must be non-negative")
+    if len(text) > max_len:
+        return text[:max_len] + "..."
+    return text
+
